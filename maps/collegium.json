 "lore": {
  "line": [
   "The Unwritten Edge",
   "Here the Collegium simply stops: the street, the air, the light, cut off as clean as a page torn from a book. This is where it began."
  ],
  "arch": [
   "The Scholars' Gate",
   "The gate of the old university. Its motto is carved over the arch, and the letters rearrange themselves while you read."
  ],
  "square": [
   "The Quadrangle",
   "Where students crossed between lectures. Their footprints still glow faintly on the flags, all leading in toward the Wound."
  ],
  "statue": [
   "The First Archmage",
   "The founder of the Collegium, book open in one hand. The page is the same spell as the one that undid the city."
  ],
  "tavern": [
   "The Inkwell",
   "The students' tavern. Papers cover every table, every one the same unfinished equation."
  ],
  "chapel": [
   "The Lecture Hall",
   "A lecture was under way when it happened. The chalk is still writing on the board, by itself, the same line over and over."
  ],
  "chapel2": [
   "The Lecture Hall",
   "A lecture was under way when it happened. The chalk is still writing on the board, by itself, the same line over and over."
  ],
  "tower": [
   "The Hall of Study",
   "The college tower. Its orrery counts down to something, and the count is getting low."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
