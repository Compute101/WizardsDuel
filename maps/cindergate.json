 "lore": {
  "gate": [
   "The Wardgate",
   "Cut open from the inside, not the outside. The gleaners only widened the hole."
  ],
  "camp": [
   "Gleaner Camp",
   "A crew has made camp in the gate's shadow. The pot on the fire is still warm and nobody is here. Their tally board counts cinderglass by the hundredweight."
  ],
  "burning": [
   "The Burning Line",
   "Past here every street is burning, and has been since the Unweaving. The fire gives off no heat until you are standing in it."
  ],
  "furnace": [
   "The Furnace Arch",
   "The old gate to the inner forges. Beyond it the light is the colour of a furnace mouth, and something walks there, and walks back."
  ],
  "smith": [
   "The Smith-Father",
   "Patron of Cindergate's forges. The bronze ran in the heat; his hammer has melted into his hand, the way the Echoes' tools have."
  ],
  "square": [
   "Forge Square",
   "Where the guild forges stood round a square of iron-grey flags. The flags are cracked in rings, as if something very hot had walked in circles here."
  ],
  "tavern": [
   "The Anvil and Ember",
   "The forgers' tavern. Tankards stand half-full on every table, the ale boiled away inside them."
  ],
  "chapel": [
   "Chapel of the Hearth",
   "Every candle in the chapel is lit, and none of them burns down."
  ],
  "lamppost": [
   "Lantern",
   "The glass is black with soot, but something inside is still burning."
  ]
 },
