 "lore": {
  "statue": [
   "The Hooded Watcher",
   "Rain has worn its face away. Someone still leaves candle stubs at its feet, and the wax is fresh."
  ],
  "shrine": [
   "Wayside Shrine",
   "The offering bowl is cracked, but it holds a single copper coin and a sprig of rosemary. Somebody here still prays."
  ],
  "brokenStatue": [
   "Fallen Hero",
   "Only the boots remain. The plaque reads: \"…ER THE BOLD, WHO HELD THE BRIDGE UNTIL THE LAST.\""
  ],
  "banner": [
   "Town Banner",
   "A gold cross on crimson, the arms of Hollowmere. The town is dead, yet someone keeps the banner raised."
  ],
  "deadtree": [
   "Scarred Oak",
   "A rune is cut deep into the bark: Ω, the sign of endings. The sap still weeps from it."
  ],
  "wheel": [
   "Cart Wheel",
   "Splintered, the iron rim gone. Whoever fled with that cart did not get far."
  ],
  "arch": [
   "North Gate",
   "The gate itself is long gone. Scorch marks lick up both pillars, higher than any torch could reach."
  ],
  "well": [
   "Old Well",
   "Your voice comes back from the dark, a moment too late, and not quite in your own words."
  ],
  "house1": [
   "The Lit House",
   "Locked. Warm light behind the shutters, and someone inside is humming an old duelling song."
  ],
  "lamppost": [
   "Lantern",
   "Still burning. No one in Hollowmere admits to lighting them."
  ],
  "crane": [
   "Dock Crane",
   "A crate still hangs from the hook, swaying though there is no wind. You decide not to open it."
  ],
  "gallows": [
   "The Gallows",
   "The town has been empty for years. The rope is new."
  ],
  "wagon": [
   "Covered Wagon",
   "Packed for a journey: blankets, salt pork, a lute with no strings. Whoever owned it left on foot."
  ],
  "sacks": [
   "Grain Sacks",
   "Rye, gone to black mould. Something has been nibbling at the corner of one, and it wasn't a rat."
  ],
  "bridgeBanner": [
   "Banner Bridge",
   "Purple and gold: the colours of the old duelling college that stood across the river. Duels were fought on this bridge at midsummer."
  ],
  "bridgeBannerBroken": [
   "Fallen Bridge",
   "Brought down on purpose. The keystones were cut through, and the cuts glow faintly when you look away."
  ],
  "bridgeWood": [
   "Mill Bridge",
   "The planks flex under you. Far below, something pale turns over in the water and is gone."
  ],
  "bridgeStone": [
   "Old Stone Bridge",
   "Older than the town. The mason's marks on the parapet are Arcana glyphs: θ Φ ☽ ∞, the Ice word."
  ],
  "bridgeWoodBroken": [
   "Broken Footbridge",
   "Snapped in the middle. The far half still creaks as though someone were crossing it."
  ],
  "tavern": [
   "The Drowned Crow",
   "The last tavern in Hollowmere. The fire is lit, the tankards are clean, and the chairs are all turned to face the door."
  ],
  "chapel": [
   "Chapel of the Watcher",
   "The hooded figure in the niche matches the statue in the plaza. The pews are dusty, all but the front one."
  ],
  "tower": [
   "The College Tower",
   "All that stands of the duelling college. The brass orrery on its roof still turns, tracking stars that are not in the sky."
  ],
  "pond": [
   "Mill Pond",
   "Fat carp circle in the shallows, unafraid. Someone still comes down here to feed them."
  ],
  "river": [
   "The Hollow",
   "Black water, slow and cold. It runs north to south, and the townsfolk said it ran the other way at night."
  ]
 },
