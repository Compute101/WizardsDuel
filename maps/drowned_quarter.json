 "lore": {
  "line": [
   "The Drowning Line",
   "The harbour rose and never fell. Past here the streets are under black water, and lanterns still burn beneath it."
  ],
  "arch": [
   "The Harbour Arch",
   "The gate to the old docks, half sunk. Something has scored the stone at the waterline, again and again, from the inside."
  ],
  "square": [
   "Fishmarket Square",
   "The fishmongers' slabs are still laid out. What is on them now came up out of the water by itself."
  ],
  "statue": [
   "The Harbour-Master",
   "His bronze spyglass points out to sea. Barnacles have grown over it, though the sea is a mile away."
  ],
  "tavern": [
   "The Mermaid's Rest",
   "Sailors' tavern. The floor is a hand deep in water, and the tide in it comes and goes on the hour."
  ],
  "chapel": [
   "Chapel of the Drowned",
   "Every pew is wet, as though the congregation has only just stood up and walked out of the sea."
  ],
  "chapel2": [
   "Chapel of the Drowned",
   "Every pew is wet, as though the congregation has only just stood up and walked out of the sea."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "river": [
   "The Hollow",
   "The river comes in under the harbour wall clean and green, and runs north toward the Wound. You do not want to see what comes out the other side."
  ],
  "bridge": [
   "Harbour Bridge",
   "Barges once passed under it to the docks. The water underneath is deep and very still, and the reflection of the bridge has people on it."
  ],
  "bridgeBroken": [
   "Fallen Bridge",
   "The current took the middle span. Something has tied the two ends together with weed and rope, but it would never take your weight."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
