 "lore": {
  "line": [
   "The Rime Wall",
   "The great market froze mid-trade. Past here the ice has grown into a wall of glassy spires, and the traders stand inside it, still haggling."
  ],
  "arch": [
   "The Market Gate",
   "The tolls are still posted on the gate. Someone has scratched a new line at the bottom: \"PRICE OF ENTRY: WARMTH.\""
  ],
  "square": [
   "The Great Market",
   "A thousand stalls under a thousand awnings, every one rimed with frost. The apples are still red under the ice."
  ],
  "statue": [
   "The Alderman",
   "The market's chief magistrate, with his chain of office and his scales. The scales are frozen tipping, and won't say which way."
  ],
  "tavern": [
   "The Hearthstone",
   "The traders' tavern. The fire in the hearth is frozen, every flame of it, in the shape of a fire."
  ],
  "chapel": [
   "Chapel of the Long Winter",
   "The candles are frozen alight. You can see the flames, pale blue, perfectly still."
  ],
  "chapel2": [
   "Chapel of the Long Winter",
   "The candles are frozen alight. You can see the flames, pale blue, perfectly still."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
