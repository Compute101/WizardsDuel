 "lore": {
  "line": [
   "The Stormwall",
   "A curtain of lightning stands across the street, fork after fork, never quite still. The cobbles under it have melted into glass."
  ],
  "arch": [
   "The Belfry Arch",
   "Every bell in Spirewatch rang at the hour of the Unweaving. Under this arch you can still hear them, very faintly, still ringing."
  ],
  "square": [
   "Bell Square",
   "Where the great bell fell. It is still here, cracked through, and it hums when lightning strikes nearby, which is always."
  ],
  "statue": [
   "The Bell-Warden",
   "The watchmen who rang the alarm bells. His hand is still raised to the rope."
  ],
  "tavern": [
   "The Copper Rod",
   "The watchmen's tavern. Every tankard has fused to the bar where lightning found it."
  ],
  "chapel": [
   "Chapel of the Tolling",
   "Its spire took the first strike. The bell rope hangs in the nave, charred black and swaying."
  ],
  "chapel2": [
   "Chapel of the Tolling",
   "Its spire took the first strike. The bell rope hangs in the nave, charred black and swaying."
  ],
  "tower": [
   "The Lightning Spire",
   "The tallest tower in the city, crowned with copper. It has been struck so many times the stone glows blue at night."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
