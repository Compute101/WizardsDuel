 "lore": {
  "heart": [
   "The Heart Tree",
   "An oak so old its lowest branches are wider than a Wrenford street. Lanterns hang in it, and walkways, and somewhere high up a child is singing. The elves say Elfhome grew round it, not the other way about."
  ],
  "watchtable": [
   "The Watch Table",
   "A great round of oak with the whole Moriquende carved into its top, hex by hex. Little wooden figures stand on it: elves, deer, wolves, goblins. Someone has carved a tiny orc and left it, face down, at the eastern edge."
  ],
  "elders": [
   "The Elders' Stone",
   "Where the Council of Elders sits: six carved seats round a stone table, under an arch of living branches. One seat for each house of Elfhome."
  ],
  "seers": [
   "The Seers' Talan",
   "A lookout platform high in the trees, with a ladder that sways. From the top, they say, a Seer can see three hexes of the wood, and a little of tomorrow."
  ],
  "healing": [
   "The Healing House",
   "Grown, not built: two trees lean together for its roof. Bundles of herbs hang under the eaves, and it smells of mint and woodsmoke. Mother Agathe's herbs come from here."
  ],
  "talons": [
   "The Talons' Lodge",
   "Longbows racked inside, a target of plaited straw, a board of notches: orcs, the Talons say, though they won't say whether the notches count the living or the dead."
  ],
  "guild": [
   "The Guild's Workshop",
   "Half-made platforms, coils of rope, pegs of seasoned yew, a pole-lathe. Everything here is built to be carried up a tree."
  ],
  "lodge": [
   "The Beast-speakers' Lodge",
   "A lodge of hide and wicker that smells of wet dog. Antlers over the door, and a trough of water left out for whatever comes."
  ],
  "herbs": [
   "Drying Herbs",
   "Feverfew, comfrey, woundwort. A label in a neat hand: \"For the Varg. Do NOT give to the Varg.\""
  ],
  "well": [
   "The Spring",
   "Cold, clear and very deep. The elves drink from it and leave the first cup for the wood."
  ],
  "stone": [
   "A Standing Stone",
   "Carved with a single leaf. It's warm to the touch, even at night."
  ],
  "cottage": [
   "An Elven Cottage",
   "Leaf-shingled, its windows lit gold. Someone inside is singing in a language you don't know."
  ],
  "target": [
   "Archery Target",
   "Straw, plaited tight. Every arrow in it is in the middle ring."
  ]
 },
