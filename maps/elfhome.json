 "lore": {
  "heart": [
   "The Heart Tree",
   "An oak so old its lowest branches are wider than a Wrenford street. Lanterns hang in it, and walkways, and somewhere high up a child is singing. The elves say Elfhome grew round it, not the other way about."
  ],
  "watchtable": [
   "The Watch Table",
   "A great round of oak with the whole Moriquende carved into its top, hex by hex. Little wooden figures stand on it: elves, deer, wolves, goblins. Someone has carved a tiny orc and left it, face down, at the eastern edge."
  ],
  "elders": [
   "The Elders' Stone",
   "Where the Council of Elders sits. The bench is worn into six hollows, one for each house of Elfhome."
  ],
  "seers": [
   "The Seers' Talan",
   "A lookout platform high in the trees, with a ladder that sways. From the top, they say, a Seer can see three hexes of the wood, and a little of tomorrow."
  ],
  "healing": [
   "The Healing House",
   "Bundles of herbs hang from every beam. It smells of mint and woodsmoke and something cleaner than either. Mother Agathe's herbs come from here."
  ],
  "talons": [
   "The Talons' Lodge",
   "Longbows racked by the door, a target of plaited straw, a board of notches: orcs, the Talons say, though they won't say whether the notches count the living or the dead."
  ],
  "guild": [
   "The Guild's Workshop",
   "Half-made platforms, coils of rope, pegs of seasoned yew. Everything here is built to be carried up a tree."
  ],
  "lodge": [
   "The Beast-speakers' Lodge",
   "A hide tent that smells of wet dog. Antlers over the door, and a bowl of water left out for whatever comes."
  ],
  "herbs": [
   "Drying Herbs",
   "Feverfew, comfrey, woundwort. A label in a neat hand: \"For the Varg. Do NOT give to the Varg.\""
  ],
  "well": [
   "The Spring",
   "Cold, clear and very deep. The elves drink from it and leave the first cup for the wood."
  ],
  "road": [
   "The West Road",
   "The road from Wrenford gives up a little way back, at a stile. The elves never fixed it, on purpose."
  ]
 },
