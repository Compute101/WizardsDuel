 "lore": {
  "forge": [
   "A Guild Forge",
   "The furnace has not gone out since the Unweaving, and nobody feeds it. Something in there is still working the bellows."
  ],
  "townhouse": [
   "A Merchant Prince's House",
   "The finest house on the hill. The windows are lit, the table is laid for twelve, and the wind has blown every chair to face the Wound."
  ],
  "gazebo": [
   "The Summer Gazebo",
   "Half its dome blew away. The musicians' stands are still set out, the sheet music pinned down by stones."
  ],
  "weathervane": [
   "The Great Weathervane",
   "The golden cockerel turns and turns. It points at the Wound every time it passes."
  ],
  "floatRoom": [
   "A Drifting Parlour",
   "Somebody's drawing room, hanging in the air with the chandelier still lit. The carpet is still on the floor; the floor is not on anything."
  ],
  "bellTower": [
   "The Great Belfry",
   "Its bell is the only one in Spirewatch still hanging. It rings by itself when lightning strikes, so it never stops."
  ],
  "watchTower": [
   "A Storm-Watch Tower",
   "The watchmen lit their beacon to warn the city. The smoke is still rising from it, the same smoke, years later."
  ],
  "fallenBell": [
   "The Fallen Bell",
   "The great bell of Bell Square, cracked through. Lay your hand on it and you can feel it ringing."
  ],
  "hall": [
   "A Lecture Hall",
   "The students were taking their examinations. The papers are still on the desks, every one answered in the same handwriting."
  ],
  "portal": [
   "The Unwritten Door",
   "An archway onto purple light. The far side of it is the Collegium too, a few seconds earlier."
  ],
  "orrery": [
   "The Great Orrery",
   "The college's model of the heavens, bent and frozen mid-turn. One of its brass planets is not in our sky."
  ],
  "sunkHouse": [
   "A Sunken House",
   "Flooded to the sills, and the lamps still lit inside. Shapes move past the windows, under the water."
  ],
  "tiltedHouse": [
   "A Heaved House",
   "The ground stood up under it and tipped it on its side. Its hearth is still burning, at an angle."
  ],
  "quarryCrane": [
   "The Quarry Crane",
   "A stone block hangs from it, turning slowly. It was being lowered when the Unweaving came, and it has not finished."
  ],
  "temple": [
   "The Temple of the Veiled Mother",
   "The great temple of Gloamside. The rose window is lit from within, by no light anybody can find."
  ],
  "mausoleum": [
   "A Family Mausoleum",
   "The iron doors are locked from the inside."
  ],
  "catacomb": [
   "The Catacomb Stair",
   "Down into the dark under Gloamside. Torches are lit all the way down, as far as you can see, and further."
  ],
  "frostStall": [
   "A Market Stall",
   "Frozen mid-sale: a hand of ice still reaching for a coin on the counter."
  ],
  "frozenFountain": [
   "The Frozen Fountain",
   "The fountain froze in the moment the Unweaving struck. You can see the shape of the coin someone was throwing in, caught in the spray."
  ],
  "line": [
   "The Torn Sky",
   "Past here the hill houses came loose. Roofs, walls, whole parlours drift overhead on a wind that never drops, turning slowly, still furnished."
  ],
  "arch": [
   "The Weathervane Gate",
   "The gate to the upper Heights. Its iron weathervane spins without pause, and always points at you."
  ],
  "square": [
   "Belvedere Square",
   "The finest view in Corvanthe, they said. The paving has been scoured smooth as glass by the wind."
  ],
  "statue": [
   "The Lady of the Winds",
   "A noblewoman with her veil streaming out behind her, carved in marble so fine the wind seems to move it. It does."
  ],
  "tavern": [
   "The Gilded Kite",
   "A wine-house for the rich. Every bottle on the shelves has been uncorked, and every one is empty and singing faintly in the draught."
  ],
  "chapel": [
   "Chapel of the Open Sky",
   "The roof was meant to open for the summer festivals. It is open now, for good, and the hymnals turn their own pages."
  ],
  "chapel2": [
   "Chapel of the Open Sky",
   "The roof was meant to open for the summer festivals. It is open now, for good, and the hymnals turn their own pages."
  ],
  "tower": [
   "The Observatory",
   "The great brass telescope is aimed straight down, at the Wound."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
