 "lore": {
  "line": [
   "The Upheaval",
   "The ground stood up here. Bedrock has broken through the streets in walls and spires, and it is still, slowly, rising."
  ],
  "arch": [
   "The Masons' Gate",
   "The guild of masons built it to last a thousand years. The ground has tilted it over like a doorstop."
  ],
  "square": [
   "Hewers' Yard",
   "Where the great blocks were dressed. Half-finished statues stand in rows, and none of them are where they were yesterday."
  ],
  "statue": [
   "The Unfinished Saint",
   "The masons never finished her face. Since the Unweaving, she has been finishing it herself."
  ],
  "tavern": [
   "The Chisel and Pick",
   "The quarrymen's tavern. Grit falls from the ceiling all the time, and nobody ever came to sweep it."
  ],
  "chapel": [
   "Chapel of the Bedrock",
   "Built straight onto the stone. The stone has started growing up through the floor, in shapes like kneeling people."
  ],
  "chapel2": [
   "Chapel of the Bedrock",
   "Built straight onto the stone. The stone has started growing up through the floor, in shapes like kneeling people."
  ],
  "wall": [
   "The City Wall",
   "The outer wall of Corvanthe. From this side, every stone is scratched with tally marks, in groups of five."
  ],
  "crane": [
   "The Harbour Crane",
   "Its hook hangs in the water of the street below, and the chain is taut. Something down there is holding on."
  ],
  "gallows": [
   "The Quarry Hoist",
   "The great hoist that lifted blocks out of the pit. The rope is still running, slowly, up out of the ground."
  ],
  "wagon": [
   "A Trader's Wagon",
   "Frozen solid with its goods still on it: bolts of cloth, sacks of salt, a cage with a frozen songbird in it, mid-song."
  ]
 },
